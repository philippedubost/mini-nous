# Variables d'environnement — fichier unique à la racine (jamais dans pipeline/)
# Local : copier en .env ou env | Vercel : Settings → Environment Variables
# Note : en local, les valeurs du fichier .env remplacent les variables déjà définies dans le terminal Windows.

FAL_KEY=your_fal_api_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=animations
R2_PUBLIC_DOMAIN=pub-xxxx.r2.dev

# Stripe LIVE — Vercel Production uniquement (Dashboard en mode live)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe TEST — local + Vercel Preview/Development (Dashboard en mode test)
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...

# Local : 1 = utilise STRIPE_*_TEST | Vercel Preview/Dev : activé automatiquement
STRIPE_USE_TEST=1

# URL publique — success/cancel Checkout + webhook Stripe
SITE_URL=https://mini-nous-olive.vercel.app

# Production hebdo
PRODUCTION_WEEK_CAPACITY=100

# Batch maker (optionnel)
# BATCH_SHEET_MM=1000
# BATCH_KERF_MM=-0.1
