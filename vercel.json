{
  "buildCommand": "npm run build",
  "installCommand": "npm install && cd pipeline && npm install",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:route", "destination": "/api/index?route=:route" },
    { "source": "/pipeline", "destination": "/pipeline/index.html" },
    { "source": "/pipeline/:path*", "destination": "/pipeline/index.html" }
  ]
}
